generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Airplane {
  id          Int      @id @default(autoincrement())
  modelNumber String
  capacity    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  flights     Flight[]
  seats       Seat[]
}

model City {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  airports  Airport[]
}

model Airport {
  name             String   @unique
  code             String   @unique
  address          String?  @unique
  cityId           Int
  id               Int      @id @default(autoincrement())
  city             City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  arrivalFlights   Flight[] @relation("ArrivalAirport")
  departureFlights Flight[] @relation("DepartureAirport")
}

model Flight {
  id                 Int      @id @default(autoincrement())
  flightNumber       String
  airplaneId         Int
  departureAirportId String
  arrivalAirportId   String
  arrivalTime        DateTime
  departureTime      DateTime
  price              Int
  boardingGate       String?
  totalSeats         Int
  airplane           Airplane @relation(fields: [airplaneId], references: [id], onDelete: Cascade)
  arrivalAirport     Airport  @relation("ArrivalAirport", fields: [arrivalAirportId], references: [code], onDelete: Cascade)
  departureAirport   Airport  @relation("DepartureAirport", fields: [departureAirportId], references: [code], onDelete: Cascade)
}

model Seat {
  id         Int      @id @default(autoincrement())
  airplaneId Int
  row        Int
  col        String
  type       SeatType @default(ECONOMY)
  airplane   Airplane @relation(fields: [airplaneId], references: [id], onDelete: Cascade)
}

model Booking {
  id        Int           @id @default(autoincrement())
  flightId  Int
  userId    Int
  status    BookingStatus @default(INITIATED)
  noOfSeats Int           @default(1)
  totalCost Int
  createdAt DateTime      @default(now())
  updatedAt DateTime
}

enum SeatType {
  BUSINESS
  ECONOMY
  PREMIUM_ECONOMY
  FIRST_CLASS
}

enum BookingStatus {
  BOOKED
  CANCELLED
  INITIATED
  PENDING
}
